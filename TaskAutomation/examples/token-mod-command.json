{
  "schemaVersion": 1,
  "id": "token-mod-command",
  "revision": 1,
  "name": "Other-Mod command",
  "description": "Send an approved TokenMod command for the selected token, by ID. Shown as dispatched, not confirmed.",
  "enabled": true,
  "parameters": {},
  "bindings": {
    "token": {
      "from": "selected",
      "objectType": "graphic",
      "max": 1
    }
  },
  "access": {
    "mode": "gmOnly",
    "authority": "initiator"
  },
  "triggers": [
    {
      "id": "manual",
      "type": "manual"
    }
  ],
  "policy": {
    "concurrency": "allow",
    "maxConcurrent": 5,
    "onError": "fail"
  },
  "steps": [
    {
      "id": "mark-blue",
      "type": "integration.command",
      "command": "!token-mod --ids {{args.token}} --set statusmarkers|+blue",
      "args": {
        "token": {
          "ref": "target.token.id"
        }
      }
    }
  ]
}
